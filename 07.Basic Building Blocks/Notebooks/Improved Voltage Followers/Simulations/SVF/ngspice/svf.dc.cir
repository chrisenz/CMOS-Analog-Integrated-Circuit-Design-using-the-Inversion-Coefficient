Simulation of the SSF with the EKV 2.6 model by C. Enz

.include ekv018va.par ; model file for EKV2.6
.include size_bias.par ; Size and bias values
.include svf.dc.par ; Parameter for the DC simulation
.include svf.net ; Circuit netlist

.control
 op
 dc Vin $&Vinmin $&Vinmax $&dVin
 let Vin = v(in)
 let Vout = v(out)
 set wr_singlescale
 set wr_vecnames
 wrdata $inputdir/svf.dc.dat Vin Vout
.endc
.end